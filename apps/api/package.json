{
  "name": "@havefolio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "pnpm test:unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@havefolio/config": "workspace:*",
    "@havefolio/contracts": "workspace:*",
    "@havefolio/domain": "workspace:*",
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@havefolio/test-utils": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "@havefolio/db": "workspace:*"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json",
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

{
  "name": "havefolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.8.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm check",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm build:packages && pnpm --parallel --filter './apps/**' run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm build:packages && eslint .",
    "test": "pnpm test:unit && pnpm test:components",
    "typecheck": "pnpm build:packages && pnpm --filter './apps/**' -r --if-present typecheck",
    "test:infra": "pnpm build:packages && python3 -m unittest discover -s scripts/shared-services -p \"test_*.py\" && node --test scripts/shared-services/config.test.mjs",
    "test:unit": "pnpm test:infra && pnpm --filter @havefolio/test-utils test && pnpm --filter @havefolio/api test:unit",
    "test:integration": "pnpm build:packages && pnpm --filter @havefolio/api test:integration",
    "test:components": "pnpm build:packages && pnpm --filter @havefolio/web test:components",
    "test:smoke": "pnpm --filter @havefolio/web test:smoke",
    "db:generate": "pnpm --filter @havefolio/db db:generate",
    "db:check": "pnpm --filter @havefolio/db db:check",
    "db:migrate": "pnpm --filter @havefolio/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}

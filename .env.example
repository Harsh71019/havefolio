# Kan project-management integration
KAN_BASE_URL=http://kan.example.test:3001
KAN_API_BASE_URL=http://kan.example.test:3001/api/v1
KAN_BOARD_PUBLIC_ID=REPLACE_WITH_BOARD_PUBLIC_ID
KAN_API_KEY=REPLACE_WITH_PROTECTED_SECRET

# Web
WEB_PORT=3000
# Trusted API upstream, including /api/v1, used at web build time for auth/taxonomy same-origin rewrites.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# API
# Empty by default; comma-separated exact proxy IPs only, never trust all proxies.
API_TRUST_PROXY=
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
# Optional trusted LAN HTTP sign-in; leave empty for HTTPS-only production.
# Credentials/sessions on this exact private IPv4 origin travel unencrypted.
AUTH_LAN_HTTP_ORIGIN=
API_DOCS_ENABLED=true

# API producer transport. The API file uses havefolio_dev_api.
REMINDER_QUEUE_ENABLED=false
VALKEY_HOST=shared-redis
VALKEY_PORT=6379
VALKEY_USERNAME=havefolio_dev_api
VALKEY_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
VALKEY_DATABASE=0
VALKEY_PREFIX=havefolio:dev

# Worker queue transport. The worker file overrides VALKEY_USERNAME with
# havefolio_dev_worker and reuses the runtime DATABASE_URL.
WORKER_QUEUE_ENABLED=false
REMINDER_RECONCILE_INTERVAL_SECONDS=60
# Optional generic notification only; never include desire names, notes or URLs.
NTFY_ENABLED=false
NTFY_ENDPOINT=http://ntfy.example.test/havefolio
NTFY_TOKEN=REPLACE_WITH_PROTECTED_SECRET

# Shared
NODE_ENV=development
LOG_LEVEL=info

# Never put real credentials in this tracked example file.

# API runtime only; migrations receive a separate protected environment file.
DATABASE_URL=postgresql://havefolio_dev_runtime:REPLACE_WITH_PROTECTED_SECRET@shared-postgres:5432/havefolio_dev
# Migration job only: never pass this credential to API/web/worker.
MIGRATION_DATABASE_URL=postgresql://havefolio_dev_migrate:REPLACE_WITH_PROTECTED_SECRET@shared-postgres:5432/havefolio_dev

# Integration only: dedicated *_test database, distinct migration/runtime roles.
# Load a protected test-only file; never fall back to normal application URLs.
TEST_DATABASE_URL=postgresql://REPLACE_WITH_TEST_RUNTIME_ROLE:REPLACE_WITH_PROTECTED_SECRET@REPLACE_WITH_TEST_HOST:5432/REPLACE_WITH_DATABASE_test
TEST_MIGRATION_DATABASE_URL=postgresql://REPLACE_WITH_TEST_MIGRATION_ROLE:REPLACE_WITH_PROTECTED_SECRET@REPLACE_WITH_TEST_HOST:5432/REPLACE_WITH_DATABASE_test
TEST_VALKEY_HOST=REPLACE_WITH_TEST_HOST
TEST_VALKEY_PORT=6379
TEST_VALKEY_USERNAME=REPLACE_WITH_TEST_API_IDENTITY
TEST_VALKEY_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
TEST_VALKEY_ACL_ENFORCED=true

# Server-only private Cloudinary adapter (PER-12). No NEXT_PUBLIC_ credentials.
# Enabling the adapter does not expose HTTP upload routes; PER-7/8/13/14 supply those gates.
MEDIA_STORAGE_ENABLED=false
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_PROTECTED_SECRET
CLOUDINARY_API_SECRET=REPLACE_WITH_PROTECTED_SECRET
# PER-45 local photo/receipt OCR (off by default). Enable both together: the API flag only
# advertises availability; the worker flag registers the local adapter and requires the
# Cloudinary values above plus the runtime DATABASE_URL in the worker environment.
ENRICHMENT_OCR_ENABLED=false
OCR_ENABLED=false

# Private owner authentication (PER-8); disabled registration is safe in every environment.
# Enable briefly for initial owner creation, then disable again. No second login owner is allowed.
AUTH_REGISTRATION_ENABLED=false
AUTH_ARGON_MEMORY_KIB=65536
AUTH_ARGON_TIME_COST=3
AUTH_ARGON_PARALLELISM=1
AUTH_SESSION_IDLE_SECONDS=86400
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_SESSION_MAX_RETAINED=10
AUTH_RATE_WINDOW_SECONDS=300
AUTH_RATE_SOURCE_LIMIT=30
AUTH_RATE_ACCOUNT_SOURCE_LIMIT=5
AUTH_RATE_KEY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_SECRET_CHARACTERS
# HTTPS production: NODE_ENV=production, API_CORS_ORIGIN=https://app.example.test,
# VALKEY_PREFIX=havefolio:production and VALKEY_USERNAME=havefolio_production_api.
# Disable public API docs at deployment unless intentionally needed.

# Server-only API/worker logging. Never use NEXT_PUBLIC_ for telemetry credentials.
LOG_APPLICATION=havefolio
# Set api or worker per deployment secret file; empty uses the process default.
LOG_SERVICE=
LOG_RELEASE=local
LOG_PRETTY=true
SEQ_ENABLED=false
# Internal existing Seq base URL or /ingest/clef; no query or embedded credentials.
SEQ_ENDPOINT=http://seq.example.test:5341
SEQ_API_KEY=REPLACE_WITH_PROTECTED_INGESTION_KEY

# PER-49 optional monitoring. Invalid enabled settings disable monitoring only.
GLITCHTIP_ENABLED=false
GLITCHTIP_DSN=REPLACE_WITH_PROTECTED_PROJECT_DSN
GLITCHTIP_TRACE_SAMPLE_RATE=0.01
# Browser build receives only the project's public ingestion DSN, never upload credentials.
NEXT_PUBLIC_GLITCHTIP_ENABLED=false
NEXT_PUBLIC_GLITCHTIP_DSN=REPLACE_WITH_PUBLIC_PROJECT_DSN
NEXT_PUBLIC_GLITCHTIP_TRACE_SAMPLE_RATE=0.01
NEXT_PUBLIC_MONITORING_RELEASE=local
# Build-secret file only: do not set these in runtime containers.
GLITCHTIP_UPLOAD_SOURCE_MAPS=false
SENTRY_URL=https://glitchtip.example.test
SENTRY_ORG=REPLACE_WITH_ORGANIZATION
SENTRY_PROJECT=REPLACE_WITH_PROJECT
SENTRY_AUTH_TOKEN=REPLACE_WITH_PROTECTED_RELEASE_TOKEN

# PER-102 optional local Amazon image importer. Load these from an ignored .env.
# Include /api/v1 or supply the app origin. No server/provider credentials required.
HAVEFOLIO_API_URL=https://app.example.test/api/v1
# Current owner session cookie VALUE, not a Bearer/API key; expires with your session.
HAVEFOLIO_TOKEN=
# Optional override: __Host-havefolio_session (HTTPS), havefolio_session (local dev),
# or havefolio_lan_session (explicitly configured trusted LAN HTTP).
HAVEFOLIO_COOKIE_NAME=
HAVEFOLIO_ALLOW_HTTP=false
# Used only when creating a new item; no catalogue price/date is imported.
HAVEFOLIO_CURRENCY=INR
# Optional absolute path. Default: ~/.havefolio-scraper-profile (dedicated Chrome profile).
HAVEFOLIO_SCRAPER_PROFILE=

{
  "name": "@havefolio/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/kibo-ui/pill": "./src/components/kibo-ui/pill/index.tsx",
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": "./src/components/*.tsx",
    "./components/kibo-ui/pill": "./src/components/kibo-ui/pill/index.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.49.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  }
}
